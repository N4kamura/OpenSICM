# ==============================================================
# OpenSICM - Configuración del Gateway GPS para ATU
# ==============================================================

# Entorno ('development' | 'production')
NODE_ENV=development

# Puerto del Servidor Web (Dashboard de monitoreo y API REST)
HTTP_PORT=3000

# Puerto de Ingesta TCP directa para equipos GPS (Teltonika, Suntech, Queclink, etc.)
GPS_INGEST_PORT=5001
GPS_TCP_ENABLED=true

# Endpoint WebSocket del SICM ATU
# En desarrollo / pruebas locales, apuntar al mock server: ws://localhost:5000/ws
# En producción, usar el endpoint oficial provisto por la ATU:
# ej. ws://devrecepcion.atu.gob.pe:5000/ws o wss://sicm.atu.gob.pe/ws
ATU_WS_ENDPOINT=ws://localhost:5000/ws

# Token de autenticación de la empresa de transporte otorgado por la ATU
ATU_COMPANY_TOKEN=TOKEN_EMPRESA_DEMO_2026

# Frecuencia de transmisión reglamentaria hacia la ATU (en segundos)
TRANSMIT_INTERVAL_SEC=30

# Capacidad máxima de la cola FIFO offline (Norma MTC: >= 10,000 tramas)
OFFLINE_QUEUE_MAX_SIZE=10000

# Archivo de persistencia de cola offline en caso de reinicio
OFFLINE_QUEUE_FILE=./data/offline_queue.json
